{
  "repoFolder": "/path/to/your/repo",
  "agentFile": ".github/agents/orchestrator.agent.md",
  "instanceName": "copilot-forever",
  "copilotHome": "~/.copilot",
  "stateDir": "~/.copilot-forever",
  "host": {
    "codeCommand": "code",
    "port": 47801,
    "tokenFile": "~/.copilot-forever/token.txt",
    "startTimeoutSeconds": 180,
    "passEnv": [],
    "startVia": "auto"
  },
  "trim": {
    "thresholdMiB": 400,
    "archiveDir": "~/.copilot/session-archive"
  },
  "watch": {
    "intervalMinutes": 10,
    "quietSeconds": 120,
    "idleRecheckSeconds": 90,
    "runtimeExitTimeoutSeconds": 60,
    "continueDelaySeconds": 20,
    "continueTries": 3,
    "continueRetrySeconds": 30,
    "continueTimeoutSeconds": 180
  },
  "files": {
    "status": "logs/session-log-status.json",
    "request": "logs/trim-request.json",
    "history": "logs/trim-history",
    "handoff": "logs/agent-handoff.md"
  },
  "continueText": "Continue. Your session log was just trimmed to its latest compaction after you stopped for a log trim. Resume from the latest addendum in {handoff}.",
  "resume": {
    "enabled": true,
    "quietMinutes": 15,
    "retryMinutes": 20,
    "maxTries": 3,
    "maxPerDay": 8,
    "apiHost": null,
    "apiPort": 443,
    "probeTimeoutSeconds": 5,
    "text": "Continue. Your last turn failed on a network error at {time} and the connection is back. Check where you were (git state, running work, the latest addendum in {handoff}) before resuming."
  },
  "notify": true,
  "copilot": {
    "supportedMajors": [1],
    "knownLogVersions": [1]
  }
}
