{
  "name": "copilot-forever",
  "version": "0.1.0",
  "description": "An AI dev team that runs for days entirely in GitHub Copilot: a keep-alive kit for one long-lived agent session (standalone VS Code agent host, automatic log trims) plus a goal loop of Orchestrator, Architect, Builder and Diff Reviewer agents.",
  "license": "MIT",
  "author": "Sean Galliher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seangalliher/copilot-forever.git"
  },
  "homepage": "https://github.com/seangalliher/copilot-forever#readme",
  "type": "module",
  "bin": {
    "copilot-forever": "bin/copilot-forever.mjs"
  },
  "files": [
    "bin",
    "src",
    "agent",
    "templates",
    "demo",
    "bootstrap.mjs",
    "copilot-forever.config.example.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p jsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "check": "npm run build && npm test"
  },
  "keywords": [
    "github-copilot",
    "copilot-cli",
    "vscode",
    "agent-host-protocol",
    "long-running-agent",
    "agentic-loop",
    "custom-agents",
    "autonomous-agents"
  ],
  "dependencies": {
    "@microsoft/agent-host-protocol": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "ws": "^8.18.0"
  }
}
